{
  "expo": {
    "name": "Ops Arrow",
    "slug": "ops-arrow",
    "scheme": "scratchcard",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F3D3E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.aceocta.opsarrow",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F3D3E"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.aceocta.opsarrow",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ops Arrow to use your camera for barcode scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Ops Arrow to use your camera to capture delivery notes.",
          "photosPermission": "Allow Ops Arrow to access photos to import delivery notes."
        }
      ],
      "expo-system-ui",
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5",
            "extraPods": [
              {
                "name": "MLKitVision",
                "version": "~> 10.0"
              },
              {
                "name": "MLKitCommon",
                "version": "~> 14.0"
              },
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "FirebaseCoreInternal",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:5268/api",
      "appDisplayName": "Ops Arrow",
      "enableDevAuthBypass": false,
      "devBypassEmail": "dev.shopowner@scratchcard.local",
      "devBypassFullName": "Development Company Owner",
      "devBypassRole": "CompanyOwner",
      "eas": {
        "projectId": "0590bfc2-b688-4ba7-af2a-c68b50715799"
      }
    },
    "owner": "opsarrow"
  }
}
