{
  "expo": {
    "name": "Ops Arrow",
    "slug": "ops-arrow",
    "scheme": "scratchcard",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F3D3E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.aceocta.opsarrow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F3D3E"
      },
      "package": "com.aceocta.opsarrow",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ops Arrow to use your camera for barcode scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Ops Arrow to use your camera to capture delivery notes.",
          "photosPermission": "Allow Ops Arrow to access photos to import delivery notes."
        }
      ],
      "expo-system-ui",
      "expo-font",
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:5268/api",
      "appDisplayName": "Ops Arrow",
      "enableDevAuthBypass": false,
      "devBypassEmail": "dev.shopowner@scratchcard.local",
      "devBypassFullName": "Development Shop Owner",
      "devBypassRole": "ShopOwner",
      "eas": {
        "projectId": "f1ea68f4-7d49-43f8-b522-2e8aeb9756d0"
      }
    },
    "owner": "sukirrajadurai"
  }
}
